+def _parse_web_switch(value: Any, default: bool) -> bool:
+    text = str(value).strip().lower()
+    if text in ('是', 'yes', 'y', 'true', '1', 'on', 'enable', 'enabled'):
+        return True
+    if text in ('否', 'no', 'n', 'false', '0', 'off', 'disable', 'disabled'):
+        return False
+    return default
+
+
+def get_web_runtime_snapshot() -> dict[str, Any]:
+    """返回供 Web 管理界面展示的运行时快照。
+
+    只暴露白名单内的状态字段，绝不包含 Cookie、账号密码、token 等敏感信息。
+    """
+    now_time = datetime.datetime.now()
+    uptime_seconds = max(int((now_time - app_start_time).total_seconds()), 0)
+    hours, remainder = divmod(uptime_seconds, 3600)
+    minutes, seconds = divmod(remainder, 60)
+
+    recording_detail: dict[str, Any] = {}
+    try:
+        for record_name in list(recording or ()):
+            key = str(record_name)
+            time_info = recording_time_list.get(record_name) if recording_time_list else None
+            start_text, quality_text = '', ''
+            if isinstance(time_info, (list, tuple)) and time_info:
+                start_at = time_info[0]
+                quality_text = str(time_info[1]) if len(time_info) > 1 else ''
+                start_text = (start_at.strftime('%Y-%m-%d %H:%M:%S')
+                              if isinstance(start_at, datetime.datetime) else str(start_at))
+            recording_detail[key] = {'start_time': start_text, 'quality': quality_text}
+    except Exception:
+        recording_detail = {}
+
+    try:
+        running_snapshot = [str(item) for item in running_list]
+    except Exception:
+        running_snapshot = []
+
+    return {
+        'version': str(version),
+        'uptime_seconds': uptime_seconds,
+        'uptime_text': '{0}小时{1}分{2}秒'.format(hours, minutes, seconds),
+        'monitoring': monitoring,
+        'recording': recording_detail,
+        'recording_count': len(recording_detail),
+        'recording_time_list': recording_detail,
+        'running_list': running_snapshot,
+        'max_request': globals().get('max_request', 0),
+        'error_count': error_count,
+        'exit_recording': bool(exit_recording),
+    }
+
+
